#!/usr/bin/env python3
"""Install the dev-harness secret guard into one repo's .git/hooks as a self-contained copy.

usage: install-git-hooks [--no-personal] <repo>

--no-personal turns off the home-path / email rules (token, key and credential rules always
run). Refuses a linked worktree (its hooks dir is shared), a repo with core.hooksPath set
(git would never run .git/hooks), and an existing hook it did not install. Checks everything
before writing anything, then prints each path it wrote.
"""
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SOURCES = {
    "pre-commit": HERE / "git-hooks" / "pre-commit",
    "pre-merge-commit": HERE / "git-hooks" / "pre-merge-commit",
    "commit-msg": HERE / "git-hooks" / "commit-msg",
    "pre-push": HERE / "git-hooks" / "pre-push",
    "dev_harness_hook.py": HERE / "git-hooks" / "dev_harness_hook.py",
    "secret_scan.py": HERE.parent / "hooks" / "lib" / "secret_scan.py",
}
MARKER = "dev-harness"
HOOK_NAMES = ("pre-commit", "pre-merge-commit", "commit-msg", "pre-push")


def git(repo: str, *args: str) -> str:
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True).stdout.strip()


def fail(message: str) -> int:
    print(f"install-git-hooks: {message}", file=sys.stderr)
    return 1


def main(argv) -> int:
    personal = "--no-personal" not in argv
    targets = [a for a in argv if a != "--no-personal"]
    if len(targets) != 1:
        return fail("usage: install-git-hooks [--no-personal] <repo>")
    repo = targets[0]
    git_dir = git(repo, "rev-parse", "--path-format=absolute", "--git-dir")
    common = git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if not git_dir:
        return fail(f"{repo} is not a git repository")
    if git_dir != common:
        return fail(f"{repo} is a linked worktree; its hooks dir is shared with the main checkout")
    if git(repo, "config", "core.hooksPath"):
        return fail("core.hooksPath is set, so git would not run .git/hooks")
    hooks = Path(common) / "hooks"
    for name in HOOK_NAMES:
        existing = hooks / name
        if existing.exists() and MARKER not in existing.read_text(errors="replace"):
            return fail(f"{existing} exists and was not installed by dev-harness")
    hooks.mkdir(exist_ok=True)
    written = []
    for name, source in SOURCES.items():
        shutil.copy2(source, hooks / name)
        written.append(hooks / name)
    conf = hooks / "dev-harness.conf"
    conf.write_text(f"personal={'on' if personal else 'off'}\n")
    written.append(conf)
    for name in HOOK_NAMES:
        (hooks / name).chmod(0o755)
    for path in written:
        print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
